# Package Managers
vcpkg_installed/

# Vendored third-party dependencies are committed (clone-and-build).
# Exclude only build-irrelevant bulk (assimp test models, 200+ MB):
engine/dependencies/assimp/test/

# ImGui runtime layout file (regenerated at runtime)
imgui.ini

# Editor runtime config (recent scene files, regenerated at runtime)
editor_config.ini

# Misc
*.log
*.tmp
*.temp
.DS_Store

# SVN
.svn/

vc140.pdb

# Engine design/notes docs - kept local, not version-controlled
engine/**/*.md

# Documents — now version-controlled in git (multi-agent collaboration requires
# worktrees to see shared docs; 2026-10-03 admin decision, was SVN-managed before)

# Agent worktrees (each agent works in .worktrees/<name> on its own branch)
.worktrees/

# Test fixture assets (tracked on purpose; *.obj above is for compiled objects)
!engine/tests/assets/*.obj
